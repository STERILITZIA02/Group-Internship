{
  "name": "garden-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "10.8.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @garden/api --filter @garden/web run dev",
    "api": "pnpm --filter @garden/api start",
    "mcp": "node apps/api/src/mcp.ts",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.tools.json",
    "test": "node --test apps/api/test/*.test.ts apps/web/test/*.test.ts",
    "build": "pnpm --filter @garden/web build",
    "lint": "eslint apps/web/src apps/api/src packages/scene/src config",
    "format:check": "prettier --check apps packages config e2e eslint.config.mjs playwright.config.ts",
    "test:browser": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.4.2"
  }
}
